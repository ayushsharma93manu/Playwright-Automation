{
  "name": "automationexercise-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI automation framework (POM, custom fixtures, Allure) for automationexercise.com",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:signup": "playwright test tests/02-signup-flow.spec.ts",
    "typecheck": "tsc --noEmit",
    "report:html": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "clean": "rimraf allure-results allure-report playwright-report test-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.7.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
